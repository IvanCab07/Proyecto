# URL del backend que consume la web (se "hornea" en el build de Vite).
# Local:              http://localhost:3000/api
# Producción (Render): la URL https del backend en Render + /api
#                      ej: https://hospital-api.onrender.com/api
# OJO: en producción DEBE ser https (si fuera http, el navegador bloquea las llamadas
# por "contenido mixto"). Cambiarla exige redeploy de la web.
VITE_API_URL=http://localhost:3000/api
