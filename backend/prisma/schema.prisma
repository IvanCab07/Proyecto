// ============================================================
// 📁 prisma/schema.prisma — ESQUEMA DE LA BASE DE DATOS
// ============================================================
// Este archivo define la ESTRUCTURA de la base de datos.
// Prisma lee este archivo y crea las tablas en MySQL automáticamente.
//
// Cada "model" es una TABLA en la base de datos.
// Cada campo dentro del model es una COLUMNA de esa tabla.
//
// Las RELACIONES entre tablas se definen con @relation.
// Ejemplo: Un User tiene muchos Turnos → User.turnos: Turno[]
//
// PARA APLICAR CAMBIOS A LA DB:
// npx prisma migrate dev --name descripcion_del_cambio
// ============================================================

// ── Configuración de Prisma ─────────────────────────────────

// El "generator" le dice a Prisma que genere el cliente en JavaScript
generator client {
  provider = "prisma-client-js"
}

// El "datasource" indica qué base de datos usamos y dónde está
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")  // La URL viene del archivo .env
}

// ── ENUMS (valores fijos) ───────────────────────────────────
// Un enum es un campo que solo puede tener ciertos valores.
// Ejemplo: el rol de un usuario solo puede ser PATIENT o ADMIN.

enum Role {
  PATIENT   // Paciente
  ADMIN     // Administrador
  MEDICO    // Médico con cuenta para iniciar sesión
}

enum TurnoStatus {
  PENDIENTE   // Recién creado, esperando confirmación
  CONFIRMADO  // El admin lo confirmó
  CANCELADO   // El paciente o admin lo canceló
  COMPLETADO  // La consulta ya se realizó
  EN_ESPERA   // Sobreturno: el horario está ocupado y este turno espera en cola a que se libere
  AUSENTE     // El paciente no se presentó (no-show). Libera el horario para los sobreturnos
}

// ── TABLA: users (Usuarios) ─────────────────────────────────
// Guarda los datos de todos los usuarios (pacientes y admins).
model User {
  id           String   @id @default(uuid())   // ID único generado automáticamente
  email        String   @unique                 // Email (no puede repetirse)
  password     String                           // Contraseña encriptada
  nombre       String                           // Nombre del usuario
  apellido     String                           // Apellido del usuario
  dni          String   @unique                 // DNI (no puede repetirse)
  telefono     String?                          // Teléfono (opcional, el "?" significa eso)
  role         Role     @default(PATIENT)       // Rol (por defecto es paciente)
  activo       Boolean  @default(true)          // Si la cuenta está habilitada para ingresar

  // ── Baja de la cuenta ──
  // Se completan cuando el admin la da de baja y se limpian al reactivarla.
  motivoBaja    String?                         // Por qué se dio de baja (lo escribe el admin)
  desactivadoAt DateTime?                       // Cuándo se dio de baja

  // ── Seguridad de cuenta ──
  emailVerified    Boolean @default(false)      // Si el email fue confirmado por el usuario
  twoFactorEnabled Boolean @default(false)      // Si activó la verificación en dos pasos (2FA)
  twoFactorSecret  String?                      // Secreto TOTP (base32) para generar/validar códigos

  // ── Calificaciones ──
  puedeCalificar   Boolean @default(true)       // Si el admin le permite calificar sus turnos completados

  createdAt    DateTime @default(now())         // Fecha de creación automática
  updatedAt    DateTime @updatedAt              // Se actualiza cada vez que se modifica

  // Relaciones: un usuario tiene muchos turnos, estudios y recetas
  turnos       Turno[]
  estudios     Estudio[]
  recetas      Receta[]

  // Estudios que este usuario subió (los propios, o los que un médico cargó para un paciente)
  estudiosSubidos Estudio[] @relation("EstudiosSubidos")

  // Calificaciones que dejó este paciente
  calificaciones Calificacion[]

  // Tokens de verificación de email / reseteo de contraseña
  verificationTokens VerificationToken[]

  // Notificaciones in-app del usuario
  notifications Notification[]

  // Si es un médico con login, su ficha de Medico (opcional)
  medico       Medico?

  @@map("users")  // Nombre real de la tabla en MySQL
}

// ── TABLA: notifications ────────────────────────────────────
// Avisos in-app que el sistema genera en eventos (turnos, recetas).
enum NotificationType {
  TURNO_SOLICITADO       // Un paciente pidió un turno (aviso para el admin)
  TURNO_CONFIRMADO       // El admin/médico confirmó el turno (aviso para el paciente)
  TURNO_CANCELADO        // Se canceló un turno (aviso para la otra parte)
  TURNO_COMPLETADO       // La consulta se realizó (aviso para el paciente)
  RECETA_NUEVA           // Se emitió una receta (aviso para el paciente)
  SOBRETURNO_SOLICITADO  // Un paciente se anotó como sobreturno (aviso para el admin)
  SOBRETURNO_ASIGNADO    // Se le cedió un sobreturno: ahora el turno es suyo (aviso para el paciente)
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  titulo    String
  mensaje   String           @db.Text
  leida     Boolean          @default(false)
  data      Json?            // Contexto: { turnoId?, recetaId?, link? }
  createdAt DateTime         @default(now())

  @@index([userId, leida])
  @@map("notifications")
}

// ── Tokens de un solo uso (verificar email, resetear contraseña) ────
// Guardamos SOLO el hash del token (nunca el valor crudo). El valor real
// viaja únicamente en el link del email.
enum TokenType {
  EMAIL_VERIFY     // Confirmar la dirección de email
  PASSWORD_RESET   // Restablecer la contraseña olvidada
}

model VerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique               // sha256 del token crudo
  type      TokenType
  expiresAt DateTime                         // Vence tras X minutos
  usedAt    DateTime?                        // Se marca cuando se consume (un solo uso)
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("verification_tokens")
}

// ── TABLA: especialidades ───────────────────────────────────
// Lista de especialidades médicas (Cardiología, Pediatría, etc.)
model Especialidad {
  id       String    @id @default(uuid())
  nombre   String    @unique                    // Nombre de la especialidad (único)
  medicos  Medico[]                             // Médicos que pertenecen a esta especialidad

  @@map("especialidades")
}

// ── TABLA: medicos ──────────────────────────────────────────
// Datos de los médicos del hospital.
model Medico {
  id             String       @id @default(uuid())
  nombre         String
  apellido       String
  matricula      String       @unique              // Matrícula profesional (única)
  especialidadId String                             // ID de su especialidad
  especialidad   Especialidad @relation(fields: [especialidadId], references: [id])
  disponible     Boolean      @default(true)        // Si está atendiendo o no
  createdAt      DateTime     @default(now())

  // Cuenta de usuario vinculada (si el médico inicia sesión). Opcional y única.
  userId         String?      @unique
  usuario        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Relaciones
  turnos         Turno[]
  recetas        Receta[]
  calificaciones Calificacion[]

  @@map("medicos")
}

// ── TABLA: turnos ───────────────────────────────────────────
// Cada turno médico que solicita un paciente.
model Turno {
  id          String      @id @default(uuid())
  pacienteId  String                                // ID del paciente que pidió el turno
  medicoId    String                                // ID del médico asignado
  fecha       DateTime                              // Fecha del turno
  hora        String                                // Hora del turno (formato "HH:MM")
  motivo           String?                               // Motivo de la consulta (opcional)
  status           TurnoStatus @default(PENDIENTE)       // Estado actual del turno
  esSobreturno     Boolean     @default(false)           // Si se pidió como sobreturno (queda en true aun tras ser cedido)
  notas            String?                               // Notas del admin (opcional)
  razonCancelacion String?                               // Razón de cancelación (opcional)
  diagnostico      String?                               // Diagnóstico/observaciones al completar
  createdAt        DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relaciones: a qué paciente y médico pertenece este turno
  paciente    User        @relation(fields: [pacienteId], references: [id])
  medico      Medico      @relation(fields: [medicoId], references: [id])

  // Calificación que dejó el paciente sobre este turno (una sola, opcional)
  calificacion Calificacion?

  @@map("turnos")
}

// ── TABLA: calificaciones ───────────────────────────────────
// Reseña que deja el paciente sobre un turno completado: estrellas (1-5) + comentario.
model Calificacion {
  id         String   @id @default(uuid())
  turnoId    String   @unique                            // Un turno se califica una sola vez
  turno      Turno    @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  pacienteId String                                       // Quién calificó
  paciente   User     @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  medicoId   String                                       // Médico calificado (desnormalizado para promedios)
  medico     Medico   @relation(fields: [medicoId], references: [id], onDelete: Cascade)
  estrellas  Int                                          // Puntaje de 1 a 5
  comentario String?  @db.Text                            // Comentario opcional
  createdAt  DateTime @default(now())

  @@index([medicoId])
  @@map("calificaciones")
}

// ── TABLA: estudios ─────────────────────────────────────────
// Archivos de estudios médicos que sube el paciente (PDFs, imágenes).
model Estudio {
  id          String   @id @default(uuid())
  pacienteId  String                                // De quién es el estudio
  subidoPorId String?                               // Quién lo subió (null = histórico previo a este campo)
  titulo      String                                // Nombre del estudio
  descripcion String?                               // Descripción opcional
  archivoUrl  String                                // Ruta al archivo guardado
  tipoArchivo String                                // Tipo MIME (image/jpeg, application/pdf)
  fecha       DateTime @default(now())              // Fecha del estudio
  createdAt   DateTime @default(now())

  paciente    User     @relation(fields: [pacienteId], references: [id])
  // Si se elimina la cuenta que lo subió, el estudio queda igual pero sin autor
  subidoPor   User?    @relation("EstudiosSubidos", fields: [subidoPorId], references: [id], onDelete: SetNull)

  @@map("estudios")
}

// ── TABLA: recetas ──────────────────────────────────────────
// Recetas médicas emitidas por los médicos.
model Receta {
  id           String   @id @default(uuid())
  pacienteId   String
  medicoId     String
  medicamento  String                               // Nombre del medicamento
  dosis        String                               // Dosis (ej: "500mg cada 8hs")
  indicacion   String                               // Indicaciones especiales
  fechaEmision DateTime @default(now())             // Fecha en que se emitió
  // Vencimiento obligatorio: una receta sin fecha no vencía nunca y el paciente no tenía
  // forma de saber si todavía servía. Si el emisor no la manda, el controller la completa
  // con fechaEmision + VALIDEZ_POR_DEFECTO_DIAS.
  validoHasta  DateTime
  createdAt    DateTime @default(now())

  paciente     User     @relation(fields: [pacienteId], references: [id])
  medico       Medico   @relation(fields: [medicoId], references: [id])

  @@map("recetas")
}