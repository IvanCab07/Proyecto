# ── Base de datos (MySQL) ──────────────────────────────────────
# Local:  mysql://root:password@localhost:3306/hospital_db
# Producción (Render): NO hay MySQL en Render → usá un MySQL administrado externo
# gratis (Aiven, Clever Cloud, etc.). Esos suelen exigir TLS, agregá el parámetro:
#   mysql://user:pass@host:puerto/db?sslaccept=strict
DATABASE_URL="mysql://root:password@localhost:3306/hospital_db"

# ── Seguridad ──────────────────────────────────────────────────
# Inventá una frase larga y aleatoria. CAMBIALA en producción.
JWT_SECRET="tu_secreto_muy_seguro_cambiar_en_produccion"
JWT_EXPIRES_IN="7d"

# ── Servidor ───────────────────────────────────────────────────
# En Render NO setees PORT: la plataforma lo inyecta y el server lo respeta.
PORT=3000
NODE_ENV=development

# ── CORS ───────────────────────────────────────────────────────
# "*" permite cualquier origen (cómodo en desarrollo).
# En producción poné la URL EXACTA de tu web (sin barra final), ej:
#   CORS_ORIGIN="https://hospital-web.onrender.com"
# Podés listar varias separadas por comas.
CORS_ORIGIN="*"

# ── Front web (para los links de los emails) ──────────────────
# URL pública de la web. Los emails de verificación y de reseteo de
# contraseña apuntan acá (ej: WEB_URL/verify-email?token=...).
WEB_URL="http://localhost:5173"

# ── Email / SMTP ──────────────────────────────────────────────
# Si dejás SMTP_HOST vacío, en desarrollo se usa una cuenta de prueba
# Ethereal automática (se imprime un link de "preview" en la consola),
# así podés probar verificación y reseteo SIN configurar nada.
# Para producción, completá con tu proveedor (Gmail app-password, Brevo,
# Mailtrap, etc.):
#   Gmail:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=tu@gmail.com  SMTP_PASS=app-password
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Hospital <no-reply@hospital.local>"
