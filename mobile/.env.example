# La app busca el backend SOLA al arrancar: en desarrollo (Expo Go en la misma red)
# normalmente NO hace falta nada acá.
#
# Definí EXPO_PUBLIC_API_URL para forzar una URL (le gana al auto-discovery). Necesario
# para apuntar a un backend desplegado:
#  - Backend en Render:  https://hospital-api.onrender.com/api
#  - Túnel local (cloudflared, etc.):  https://xxxx.trycloudflare.com/api
# EXPO_PUBLIC_API_URL=https://hospital-api.onrender.com/api

# API key de Google Maps (solo para builds de producción; en Expo Go el mapa anda sin key)
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
